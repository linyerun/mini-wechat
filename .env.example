# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机端口
APP_PORT=8090

# 可观测性面板端口（Prometheus 指标查询 / Jaeger 链路界面）
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
# 本地 go run 时可通过 localhost:4318 上报链路
JAEGER_OTLP_HTTP_PORT=4318

# 链路采样比例（0-1），生产环境可调低
OTEL_TRACES_SAMPLER_ARG=1.0

# 部署时务必修改
JWT_SECRET=please-change-this-secret

# 网络受限时可切换到国内镜像源
# NPM_REGISTRY=https://registry.npmmirror.com
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.google.cn

# Docker Hub 不可达时，可把监控组件指向镜像代理
# PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus:v2.55.1
# JAEGER_IMAGE=docker.m.daocloud.io/jaegertracing/all-in-one:1.62.0
